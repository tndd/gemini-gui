// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./gemini-gui.db"
}

model Session {
  sessionId        String    @id @map("session_id")
  name            String
  workingDirectory String    @map("working_directory")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  isActive        Boolean   @default(false) @map("is_active")
  lastAccessed    DateTime  @default(now()) @map("last_accessed")
  messages        Message[]

  @@map("sessions")
}

model Message {
  id            Int      @id @default(autoincrement())
  sessionId     String   @map("session_id")
  userInput     String   @map("user_input")
  geminiResponse String  @map("gemini_response")
  timestamp     DateTime @default(now())
  session       Session  @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)

  @@map("messages")
}